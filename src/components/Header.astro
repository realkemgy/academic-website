---
/**
 * Sticky site header. The phone menu uses the native Popover API, so it works
 * with no JavaScript, closes on Escape or an outside click, and keeps focus
 * order intact.
 */
import { NAV } from '../data/navigation';
import { getProfile, displayName } from '../utils/content';
import Text from './Text.astro';

const profile = await getProfile();
const name = displayName(profile, false);
const path = Astro.url.pathname;

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header sticky top-0 z-40 border-b border-border bg-surface/95 backdrop-blur-sm">
  <div class="wrap flex min-h-16 items-center justify-between gap-6 py-2">
    <a href="/" class="group flex min-w-0 flex-col py-1 no-underline" aria-label={`${name}, home`}>
      <Text value={name} class="truncate font-serif text-[1.15rem] leading-tight font-semibold text-fg-strong" />
      <Text
        value={profile.data.department}
        class="hidden truncate text-[0.8rem] leading-tight text-fg-muted sm:block"
      />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="menu-button btn btn-secondary xl:hidden"
      popovertarget="mobile-nav"
      aria-controls="mobile-nav"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none">
        <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      Menu
    </button>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    <nav aria-label="Main (menu)">
      <ul class="wrap py-3">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    font-size: 0.975rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.45rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav-link:hover {
    color: var(--fg-strong);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current='page'] {
    color: var(--fg-strong);
    font-weight: 600;
  }

  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    height: 2px;
    background: var(--accent);
  }

  .menu-button {
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    font-size: 0.95rem;
  }

  .mobile-nav {
    /* Popover renders in the top layer; position it under the header. */
    inset: 4.1rem 0 auto 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    box-shadow: var(--shadow-1);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--fg-strong);
    text-decoration: none;
  }

  li:last-child .mobile-link {
    border-bottom: 0;
  }

  .mobile-link[aria-current='page'] {
    color: var(--accent);
  }

  .mobile-link[aria-current='page']::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
