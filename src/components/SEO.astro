---
/**
 * Per-page metadata: title, description, canonical URL, Open Graph, robots,
 * optional scholarly citation_* tags and JSON-LD.
 */
import { SITE } from '../config/site';
import { absolute } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  siteName: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: (Record<string, unknown> | null)[];
  scholar?: { name: string; content: string }[];
}

const {
  title,
  description,
  path,
  siteName,
  image = SITE.ogImage,
  type = 'website',
  noindex = false,
  jsonLd = [],
  scholar = [],
} = Astro.props;

const canonical = absolute(path);
const imageUrl = absolute(image);
const robots = !SITE.allowIndexing || noindex ? 'noindex, nofollow' : 'index, follow';
const ld = jsonLd.filter(Boolean);
// Escape "<" so a value can never close the script element.
const ldJson = JSON.stringify(ld.length === 1 ? ld[0] : ld).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={SITE.lang.replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{scholar.map((tag) => <meta name={tag.name} content={tag.content} />)}

{ld.length > 0 && <script type="application/ld+json" is:inline set:html={ldJson} />}
