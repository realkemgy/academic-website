---
import type { Project } from '../utils/content';
import Text from './Text.astro';

interface Props {
  entry: Project;
  headingLevel?: 'h2' | 'h3';
}
const { entry, headingLevel: H = 'h3' } = Astro.props;
const d = entry.data;

const STATUS: Record<string, string> = {
  planned: 'Planned',
  'in-development': 'In development',
  active: 'Active',
  maintained: 'Maintained',
  completed: 'Completed',
  archived: 'Archived',
};
const stack = [...d.languages, ...d.technologies];
---

<article class="project-card relative flex h-full flex-col rounded-md border border-border bg-surface p-6">
  <div class="flex items-center justify-between gap-3">
    <span class="badge">{STATUS[d.status]}</span>
    {d.license && <span class="text-step--1 text-fg-muted">{d.license}</span>}
  </div>
  <H class="mt-4 text-step-2">
    <a href={`/projects/${entry.id}/`} class="project-link">{d.title}</a>
  </H>
  <Text value={d.summary} as="p" class="mt-2 text-fg" />
  {d.problem && <p class="mt-3 text-step--1 text-fg-muted"><span class="font-semibold text-fg">Problem:</span> {d.problem}</p>}
  {
    stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Languages and technologies">
        {stack.map((s) => (
          <li class="tag font-mono">{s}</li>
        ))}
      </ul>
    )
  }
  <div class="relative z-10 mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6 text-step--1">
    {d.repo && <a href={d.repo} class="font-semibold" rel="noopener">Repository<span class="sr-only"> for {d.title}</span></a>}
    {d.docs && <a href={d.docs} class="font-semibold" rel="noopener">Documentation<span class="sr-only"> for {d.title}</span></a>}
    {d.demo && <a href={d.demo} class="font-semibold" rel="noopener">Demo<span class="sr-only"> of {d.title}</span></a>}
  </div>
</article>

<style>
  .project-card {
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .project-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-1);
    transform: translateY(-2px);
  }

  .project-link {
    color: var(--fg-strong);
    text-decoration: none;
  }

  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-link:focus-visible {
    outline: none;
  }

  .project-card:has(.project-link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
</style>
