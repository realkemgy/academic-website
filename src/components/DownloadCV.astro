---
/**
 * Download CV button. Appears as a working link only when the CV file exists
 * in /public; otherwise shows a disabled, clearly marked state.
 */
import { getProfile, publicFileExists } from '../utils/content';
import { SITE } from '../config/site';

interface Props {
  variant?: 'primary' | 'secondary' | 'on-band';
  class?: string;
}
const { variant = 'secondary', class: className = '' } = Astro.props;
const profile = await getProfile();
const { cv, cvUpdated } = profile.data;
const available = /^https?:\/\//.test(cv) || publicFileExists(cv);
const btn = { primary: 'btn-primary', secondary: 'btn-secondary', 'on-band': 'btn-on-band' }[variant];
const icon = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

{
  available ? (
    <a class:list={['btn', btn, className]} href={cv} download>
      <Fragment set:html={icon} />
      Download CV
      <span class="text-[0.8em] font-normal opacity-80">(PDF{cvUpdated && `, ${cvUpdated}`})</span>
    </a>
  ) : SITE.showEditorNotes ? (
    <span class:list={['btn', btn, className]} aria-disabled="true" title="Add the CV at public/cv/academic-cv.pdf">
      <Fragment set:html={icon} />
      Download CV <span class="ph text-[0.8em] font-normal">[CV FILE]</span>
    </span>
  ) : null
}
