---
/**
 * A labelled block on detail pages. Renders nothing when it has no content,
 * so empty sections never appear on the public site.
 */
interface Props {
  title: string;
  show: boolean;
  id?: string;
}
const { title, show, id } = Astro.props;
---

{
  show && (
    <section class="detail-section grid gap-4 border-t border-border py-8 md:grid-cols-12 md:gap-8" aria-labelledby={id}>
      <h2 id={id} class="label label-accent font-sans md:col-span-3">
        {title}
      </h2>
      <div class="min-w-0 md:col-span-9">
        <slot />
      </div>
    </section>
  )
}
