---
/**
 * Research theme summary, used in Featured Research and on the Research page.
 */
import type { Research } from '../utils/content';
import Text from './Text.astro';
import ProvisionalBadge from './ProvisionalBadge.astro';

interface Props {
  entry: Research;
  index?: number;
  headingLevel?: 'h2' | 'h3';
  topicLimit?: number;
}
const { entry, headingLevel: H = 'h3', topicLimit = 5 } = Astro.props;
const d = entry.data;
const topics = d.topics.slice(0, topicLimit);
const more = d.topics.length - topics.length;
---

<article class="research-card group flex h-full flex-col border-t-2 border-fg-strong pt-5">
  <div class="flex items-center justify-between gap-3">
    <p class="label">Research theme</p>
    {!d.confirmed && <ProvisionalBadge />}
  </div>
  <H class="mt-3 text-step-2">
    <a href={`/research/${entry.id}/`} class="card-link">{d.title}</a>
  </H>
  <Text value={d.summary} as="p" class="mt-3 text-fg" />
  {
    topics.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${d.title} topics`}>
        {topics.map((t) => (
          <li class="tag">{t}</li>
        ))}
        {more > 0 && <li class="tag">+{more} more</li>}
      </ul>
    )
  }
  <p class="mt-auto pt-6">
    <span class="arrow-link" aria-hidden="true">Read about this theme <span class="arrow">&rarr;</span></span>
  </p>
</article>

<style>
  .research-card {
    position: relative;
  }

  .card-link {
    color: var(--fg-strong);
    text-decoration: none;
  }

  /* Whole card is clickable through the heading link. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .research-card:hover .card-link,
  .card-link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .research-card:hover .arrow {
    transform: translateX(3px);
  }

  .card-link:focus-visible {
    outline: none;
  }

  .research-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }
</style>
