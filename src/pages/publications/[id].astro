---
import { getCollection, getEntries } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import CopyButtons from '../../components/CopyButtons.astro';
import { authorList, formatCitation, scholarMeta, toBibtex, venue, TYPE_SINGULAR } from '../../utils/citation';
import { absolute, scholarlyArticleJsonLd } from '../../utils/seo';
import type { Publication } from '../../utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('publications', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Publication;
}
const { entry } = Astro.props;
const p = entry.data;
const path = `/publications/${entry.id}/`;
const themes = await getEntries(p.research);
const v = venue(p);
const details = [
  ['Type', TYPE_SINGULAR[p.type]],
  ['Published in', v],
  ['Year', String(p.year)],
  ['Volume', p.volume],
  ['Issue', p.issue],
  ['Pages', p.pages || p.articleNumber],
  ['Publisher', p.publisher],
  ['Status', p.status !== 'published' ? p.status.replace('-', ' ') : undefined],
].filter(([, val]) => val) as [string, string][];
---

<PageLayout
  title={p.title}
  eyebrow={TYPE_SINGULAR[p.type]}
  description={p.abstract ? p.abstract.slice(0, 155).trim() + (p.abstract.length > 155 ? '…' : '') : `${p.title}. ${authorList(p.authors)}, ${p.year}.`}
  breadcrumbs={[
    { name: 'Publications', href: '/publications/' },
    { name: p.title.length > 48 ? p.title.slice(0, 46) + '…' : p.title, href: path },
  ]}
  type="article"
  scholar={scholarMeta(p, absolute)}
  jsonLd={[scholarlyArticleJsonLd(entry, path)]}
>
  <p slot="intro" class="mt-6 text-step-1 text-fg">{authorList(p.authors)}</p>

  <div class="wrap section grid gap-12 lg:grid-cols-12">
    <article class="min-w-0 lg:col-span-8">
      {
        p.abstract && (
          <section aria-labelledby="abstract">
            <h2 id="abstract" class="label label-accent font-sans">Abstract</h2>
            <p class="prose mt-3 text-step-1">{p.abstract}</p>
          </section>
        )
      }
      {
        p.keywords.length > 0 && (
          <section class="mt-10" aria-labelledby="keywords">
            <h2 id="keywords" class="label font-sans">Keywords</h2>
            <ul class="mt-3 flex flex-wrap gap-2">{p.keywords.map((k) => <li class="tag">{k}</li>)}</ul>
          </section>
        )
      }
      <section class="mt-10" aria-labelledby="cite">
        <h2 id="cite" class="label font-sans">How to cite</h2>
        <div class="mt-3 rounded-md border border-border bg-surface-2 p-5">
          <p data-copy-source>{formatCitation(p)}</p>
          <button type="button" class="btn btn-secondary mt-3 min-h-10 px-3 py-1 text-step--1" data-copy hidden>Copy reference</button>
          <p class="label mt-6 mb-2">BibTeX</p>
          <pre class="overflow-x-auto font-mono text-[0.8rem] leading-relaxed" data-copy-source><code>{toBibtex(p)}</code></pre>
          <button type="button" class="btn btn-secondary mt-3 min-h-10 px-3 py-1 text-step--1" data-copy hidden>Copy BibTeX</button>
        </div>
      </section>
    </article>

    <aside class="lg:col-span-4" aria-label="Publication details">
      <div class="flex flex-col gap-3">
        {p.doi && <a class="btn btn-primary" href={`https://doi.org/${p.doi}`} rel="noopener">View at publisher (DOI)</a>}
        {!p.doi && p.url && <a class="btn btn-primary" href={p.url} rel="noopener">View at publisher</a>}
        {p.pdf && <a class="btn btn-secondary" href={p.pdf}>Download PDF</a>}
      </div>
      <dl class="mt-8 divide-y divide-border border-y border-border text-step--1">
        {details.map(([k, val]) => (
          <div class="grid grid-cols-[7rem_1fr] gap-3 py-2.5">
            <dt class="text-fg-muted">{k}</dt>
            <dd class="text-fg-strong">{val}</dd>
          </div>
        ))}
        {p.doi && (
          <div class="grid grid-cols-[7rem_1fr] gap-3 py-2.5">
            <dt class="text-fg-muted">DOI</dt>
            <dd class="font-mono break-all text-fg-strong">{p.doi}</dd>
          </div>
        )}
      </dl>
      {
        themes.length > 0 && (
          <div class="mt-8">
            <p class="label mb-2">Research themes</p>
            <ul class="space-y-1">{themes.map((t) => <li><a href={`/research/${t.id}/`}>{t.data.title}</a></li>)}</ul>
          </div>
        )
      }
    </aside>
  </div>
  <CopyButtons />
</PageLayout>
