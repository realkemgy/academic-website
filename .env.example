# ============================================================================
# Environment variables. Copy to .env for local development (never commit .env).
# In production, set these in the hosting dashboard instead.
#
# PUBLIC_* values are compiled into the static site and are visible to anyone.
# Everything else is read only by the contact-form function on the server.
# ============================================================================

# ---- Site (build time, public) ---------------------------------------------
# Canonical origin, apex OR www, no trailing slash. Drives canonical URLs,
# sitemap and Open Graph tags.
PUBLIC_SITE_URL=https://example.com

# Language of the content (BCP 47), e.g. en-GB, en-US.
PUBLIC_SITE_LANG=en-GB

# Allow search engines. Keep "false" for previews and until real content is in.
PUBLIC_ALLOW_INDEXING=false

# Dashed yellow editor notes explaining where content goes. Set "false" at launch.
PUBLIC_SHOW_EDITOR_NOTES=true

# ---- Contact form (build time, public) -------------------------------------
# "true" only once a backend and email provider are configured.
PUBLIC_CONTACT_FORM_ENABLED=false
# Relative path (same host) or full URL of the form handler.
PUBLIC_CONTACT_ENDPOINT=/api/contact
# Optional Cloudflare Turnstile SITE key (public). Works on any host.
PUBLIC_TURNSTILE_SITE_KEY=

# ---- Contact form (server only, secrets) -----------------------------------
# Where messages are delivered.
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified with the email provider (Resend).
CONTACT_FROM_EMAIL=
# Extra origins allowed to post (comma-separated), e.g. a www/apex alias.
CONTACT_ALLOWED_ORIGINS=
# Best-effort rate limit per IP per warm instance.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
# Reject messages containing more links than this.
CONTACT_MAX_LINKS=3
# Turnstile SECRET key. When set, a valid Turnstile token is required.
TURNSTILE_SECRET_KEY=

# Choose one: resend | graph | webhook
EMAIL_PROVIDER=

# resend: https://resend.com API key
RESEND_API_KEY=

# graph: Microsoft Graph sendMail via an Entra ID app registration with the
# Mail.Send application permission, scoped to one mailbox with Exchange Online
# RBAC for Applications (see docs/CONTACT-FORM.md).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the app sends as, e.g. website@example.com
GRAPH_SENDER=
GRAPH_SAVE_TO_SENT=true

# webhook: POST JSON to any endpoint (Power Automate, Logic Apps, n8n, Zapier)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ---- Analytics (build time, public). Off unless a provider is named. ------
# plausible | umami | cloudflare
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SCRIPT_URL=
PUBLIC_ANALYTICS_ID=
