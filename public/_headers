# Security and caching headers for Cloudflare (Pages and Workers static assets)
# and Netlify, which both read this file from the build output.
# Equivalent rules: public/staticwebapp.config.json (Azure) and vercel.json.
# Script and style sources are controlled by the CSP <meta> tag Astro writes
# into every page; the header below adds the directives a <meta> tag cannot.

/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
